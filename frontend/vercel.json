{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/register",
      "destination": "https://tournaments.khiladi-khoj.com/register",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://tournaments.khiladi-khoj.com/login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sso/start",
      "destination": "/index.html"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://khiladi-identity-api.onrender.com/api/auth/:path*"
    },
    {
      "source": "/api/sso/:path*",
      "destination": "https://khiladi-identity-api.onrender.com/api/sso/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/auth/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/sso/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
