NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
MONGODB_URI=mongodb+srv://username:password@cluster.example/khiladi_identity
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AUTH_CODE_PEPPER=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=your-central-oauth-client-id.apps.googleusercontent.com
IDENTITY_COOKIE_NAME=__Host-khiladi_identity
ACCESS_TOKEN_TTL_MINUTES=10
SESSION_TTL_DAYS=30
AUTH_CODE_TTL_SECONDS=90
SSO_ASSERTION_TTL_SECONDS=120
ACADEMY_SSO_REDIRECT_URIS=http://localhost:5173/auth/sso/callback
TOURNAMENT_SSO_REDIRECT_URIS=http://localhost:5173/auth/sso/callback
ACADEMY_SSO_ASSERTION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
TOURNAMENT_SSO_ASSERTION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
